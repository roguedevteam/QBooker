# URL of your deployed (or local) QBooker API service.
VITE_API_URL=http://localhost:4000

# URL of the qbooker-web app (admin/staff/customer) — used to link people to Admin sign-in
# right after they create an account, since that lives in a separate app now.
VITE_ADMIN_APP_URL=http://localhost:5173

# Contact address shown on the site and in the privacy notice (defaults to a placeholder).
VITE_SUPPORT_EMAIL=hello@qbooker.example

# Public URL of this marketing site (no trailing slash). Used for the canonical link, Open Graph URL,
# sitemap.xml and robots.txt. Leave unset to omit them.
# VITE_MARKETING_URL=https://www.example.com
